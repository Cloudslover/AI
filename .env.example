# ─────────────────────────────────────────────────────────────────────────
# CryptoBrain — environment configuration
# Copy to .env and fill in what you want to enable. Everything is optional:
# the engine works 100% offline-capable with Binance public market data.
# ─────────────────────────────────────────────────────────────────────────

# ── Market data ──────────────────────────────────────────────────────────
# Single-symbol default used by the dashboard/input field.
# Aliases supported: BTC -> BTCUSDT, ETH -> ETHUSDT, GOLD/XAU -> XAUUSD.
SYMBOL=BTCUSDT
# Dashboard/CLI watchlist presets for the core desk: BTC, ETH, XAU/GOLD.
# XAUUSD uses Binance PAXGUSDT spot candles as a tokenized-gold proxy while
# signals remain labeled XAUUSD.
SYMBOLS=BTCUSDT,ETHUSDT,XAUUSD
TIMEFRAME=15m
BARS=500

# ── Signal engine ────────────────────────────────────────────────────────
MIN_CONFIDENCE=55          # raw plans below this are dropped from the output
DEFAULT_RISK_REWARD=2.0    # TP1 risk:reward target
MAX_RISK_PCT=1.0           # hard ceiling for risk per trade (% of account) — advice only

# Institutional desk filter (AI Trading Intelligence System)
INTELLIGENCE_MIN_CONFIDENCE=80
INTELLIGENCE_MIN_RR=2.0
ACCOUNT_BALANCE=0          # set to enable position-size estimates
RISK_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=6.0

# ── CryptoDada website (private membership) ──────────────────────────────
# The connector can run in three modes:
#   auto  -> probe for the site's hidden JSON API first, fall back to browser
#   api   -> only use hidden API endpoints (fastest)
#   browser -> Playwright login + scrape (needs `pip install playwright`)
CRYPTODADA_MODE=auto
CRYPTODADA_BASE_URL=https://YOUR-CRYPTODADA-SITE.example
CRYPTODADA_EMAIL=
CRYPTODADA_PASSWORD=
CRYPTODADA_2FA=             # TOTP secret if the site uses 2FA (optional)

# ── Discord (private group) ──────────────────────────────────────────────
# Recommended: a webhook YOUR BOT posts INTO (outbound alerts), or
# an authenticated session to READ channels (check Discord ToS first).
DISCORD_WEBHOOK_URL=
DISCORD_TOKEN=              # user/bot token for reading channels (optional)
DISCORD_CHANNEL_IDS=        # comma-separated channel ids to read
DISCORD_ANNOUNCE_WEBHOOK=   # webhook to push signals to (optional)

# ── LLM AI Brain narrative (optional) ────────────────────────────────────
# provider: auto | groq | openai | gemini | off
LLM_PROVIDER=off
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Paper-trading runner (simulation only; never sends exchange orders) ──
# Start it with: python main.py paper --watch
PAPER_POLL_SECONDS=30
PAPER_MAX_CANDLES_PER_CHECK=1000

# ── Notifiers ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
