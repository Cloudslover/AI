# Required profile: live public data, paper-only progression.
DEMO_MODE=0
PROGRESSION=simulator
SYMBOL=BTCUSDT
SYMBOLS=BTCUSDT,ETHUSDT,XAUUSD
TIMEFRAME=15m
BARS=500

# Capital-first controls. Do not weaken these during evidence collection.
DESK_DEFAULT=true
PRIMARY_SETUP_FAMILY=sweep_trend_continuation
ENFORCE_RISK_LIMITS=true
TRADER_STATE_BLOCK=true
RISK_PCT=0.5
MAX_DAILY_LOSS_PCT=1.5
MAX_WEEKLY_LOSS_PCT=3.0
GOLD_SESSION_MODE=block
GOLD_NEWS_BLOCK=true

# Persistent state must live outside the Git checkout.
DB_PATH=/var/lib/cryptobrain/cryptobrain.db
PAPER_POLL_SECONDS=30
PAPER_MAX_CANDLES_PER_CHECK=1000

# Dashboard is write-capable. Never bind it directly to a public interface.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050

# Optional outbound alerts. No exchange API key is needed or supported.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_ANNOUNCE_WEBHOOK=
LLM_PROVIDER=off
